{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agents-doctor report (plugin 0.4.x, report schema_version 1.0)",
  "description": "Shape of scan.json produced by skills/agents-doctor/scripts/audit_scan.py. Pragmatic: unknown top-level keys are allowed (additionalProperties stays true) so enrich stages can add facts without a schema bump. Secret values are never modeled: secrets carry path/kind/mask/fingerprint only, and additionalProperties is false there so a 'value' or 'preview' key carrying raw material cannot validate.",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "home",
    "generated_at",
    "rules_version",
    "stats",
    "gates",
    "findings_detailed",
    "secrets",
    "top_level",
    "junk"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "root": {
      "type": "string"
    },
    "home": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "rules_version": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "required": [
        "total_files",
        "total_size_bytes",
        "skipped_symlinks_outside",
        "duration_sec"
      ],
      "properties": {
        "total_files": {
          "type": "number"
        },
        "total_size_bytes": {
          "type": "number"
        },
        "skipped_symlinks_outside": {
          "type": "number"
        },
        "own_source_skipped": {
          "type": "number",
          "description": "Files not read for keys because they lie in a copy of the plugin's own source tree (a folder holding both audit_scan.py and secret_rules.py); absent in reports made before the counter existed."
        },
        "duration_sec": {
          "type": "number"
        }
      }
    },
    "git_roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every folder holding a .git, as a path relative to root; '.' is the audited folder itself when it is a repository."
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gid",
          "n",
          "status"
        ],
        "properties": {
          "gid": {
            "type": "string"
          },
          "n": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
              "enum": [
                "pass",
                "fail",
                "warn",
                "unknown",
                "not_applicable"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "warn",
                      "unknown",
                      "not_applicable"
                    ]
                  },
                  "why": {
                    "type": "string",
                    "description": "Code from the glossary saying why the rule is unknown or not_applicable (no_skills_found, no_git, history_not_scanned, facts_missing, ...); absent for pass, fail and warn."
                  },
                  "count": {
                    "type": "number",
                    "description": "Number the 'why' text is written with (folders checked, repositories not read)."
                  },
                  "reason": {
                    "type": "string",
                    "description": "The same reason as an English sentence."
                  }
                }
              }
            },
            "status_reason": {
              "type": "string",
              "description": "English sentence: why the gate is unknown or not_applicable (the reason of its first rule carrying that status)."
            },
            "status_why": {
              "type": "string",
              "description": "Glossary code of that reason."
            },
            "status_count": {
              "type": "number",
              "description": "Number the reason text is written with."
            },
            "pass_when": {
            "type": "string"
          },
          "fail_when": {
            "type": "string"
          },
          "warn_when": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "confidence": {
            "type": "number"
          },
          "recommendation": {
            "type": "string"
          },
          "doc_ref": {
            "type": "string"
          }
        }
      }
    },
    "findings_detailed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fid",
          "gate",
          "category",
          "severity",
          "status",
          "title",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "fid": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "warn",
              "unknown",
              "not_applicable"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "confidence": {
            "type": "number"
          },
          "recommendation": {
            "type": "string"
          },
          "autofix_available": {
            "type": "boolean"
          },
          "schema_version": {
            "type": "string"
          },
          "harness": {
            "type": "string",
            "description": "adapter id for harness-specific findings (claude_code, codex, ...); empty for core findings"
          },
          "check_id": {
            "type": "string",
            "description": "stable check identifier (e.g. CLAUDE_INSTRUCTION_CONFLICT); fid stays a per-scan counter"
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "description": "Detections carry only a mask and a fingerprint. Raw values must never appear in a report; additionalProperties=false rejects any attempt to add e.g. a 'value' or 'preview' key.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "fingerprint"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "number"
          },
          "kind": {
            "type": "string"
          },
          "mask": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "git": {
            "type": "string",
            "enum": [
              "tracked",
              "ignored",
              "untracked"
            ],
            "description": "Where the file sits in the nearest repository around it, when there is one: tracked (in the index), ignored (kept out by .gitignore) or untracked (not added yet)."
          }
        }
      }
    },
    "top_level": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "repo",
              "dir",
              "file"
            ]
          },
          "git": {
            "type": [
              "object",
              "null"
            ]
          },
          "size_bytes": {
            "type": "number"
          },
          "extra": {
            "type": "object"
          }
        }
      }
    },
    "junk": {
      "type": "object",
      "required": [
        "files",
        "dirs",
        "empty_dirs"
      ],
      "properties": {
        "files": {
          "type": "array"
        },
        "dirs": {
          "type": "array"
        },
        "empty_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Fingerprinted findings (stable fp + section + path) used for baseline diffs.",
      "items": {
        "type": "object",
        "required": [
          "fp"
        ],
        "properties": {
          "fp": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          }
        }
      }
    },
    "duplicates": {
      "type": "array"
    },
    "large_files": {
      "type": "array",
      "description": "Files at or over the large-file threshold.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          },
          "tracked": {
            "type": "boolean",
            "description": "Present when the audited folder is a repository and git listed the file: true when the file is tracked, false when it has no history behind it."
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "description": "Skill folders and SKILL.md health (entries, duplicates).",
      "properties": {
        "coverage": {
          "type": "object",
          "description": "What the skill search actually covered; absent in reports made before it was recorded.",
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Locations (folder kinds) that were read."
            },
            "failed": {
              "type": "array",
              "description": "Folders that exist but could not be read; their rules are unknown.",
              "items": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            },
            "truncated": {
              "type": "array",
              "description": "Folders cut by the per-folder cap; their rules are unknown.",
              "items": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string"
                  },
                  "scanned": {
                    "type": "number"
                  },
                  "found": {
                    "type": "number"
                  },
                  "cap": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "harnesses": {
      "type": "array",
      "description": "detection records for every registered adapter (status detected/possible/not_found, confidence, activity, markers, evidence)",
      "items": {
        "type": "object"
      }
    },
    "harness_spec_matrix": {
      "type": "array",
      "description": "spec provenance per adapter: source URL, verified date, supported versions, known limitations",
      "items": {
        "type": "object"
      }
    },
    "instruction_conflict_summary": {
      "type": "object",
      "description": "counts by kind: contradiction, duplication, divergence"
    },
    "harness_findings_raw": {
      "type": "array",
      "description": "adapter findings before the gates engine assigns fids (internal pipeline section)",
      "items": {
        "type": "object"
      }
    }
  }
}
